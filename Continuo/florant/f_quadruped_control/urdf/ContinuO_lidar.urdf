<?xml version="1.0" encoding="utf-8"?>
<robot name="ContinuO">

  <!-- To make the robot fly -->
  <!-- Wingardium leviossssssssssssssssssa -->
  <!-- <link name="world" /> -->
  <!---->
  <!-- <joint name="fixed_to_world" type="fixed"> -->
  <!--   <parent link="world" /> -->
  <!--   <child link="base_link" /> -->
  <!--   <origin xyz="0 0 0.5" rpy="0 0 0" /> -->
  <!-- </joint> -->
  
  <material name="orange"><color rgba="0.12 0.15 0.2 1.0"/></material>
  <material name="red"><color rgba="0.6 0.2 0.0 1.0"/></material>
  <material name="black"><color rgba="0.4 0.4 0.4 1.0"/></material>
  <material name="black1"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="black2"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="black3"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="silver"><color rgba="0.79216 0.81961 0.93333 1"/></material>

  <!-- LIEN DE BASE -->
  <link name="base_link" />

  <joint name="dummy_joint" type="fixed">
    <parent link="base_link" />
    <child link="base" />
  </joint>

  <link name="base">
    <inertial>
      <origin xyz="-0.02 0.000061 0.008445" rpy="0 0 0" />
      <mass value="15.342" />
      <inertia ixx="0.131477" ixy="-0.000035" ixz="0.000257"
        iyy="0.328587" iyz="0.000031" izz="0.423802" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="./meshes/base.dae" />
      </geometry>
      <material name="red" />
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0" />
      <geometry>
        <box size="0.5 0.25 0.2" />
      </geometry>
    </collision>
  </link>
  
  <!-- LIDAR OUSTER -->
  <link name="os_sensor">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.425" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.073" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.073" />
      </geometry>
    </collision>
  </link>

  <joint name="base_to_lidar" type="continuous">
    <origin xyz="0.3 0 0.05" rpy="0 0.52 0" />
    <parent link="base" />
    <child link="os_sensor" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.1" friction="0.05" />
    <!-- Limites calculées d'après tes specs Maxon DCX16S -->
    <limit effort="2.28" velocity="10.37" />
  </joint>

  <!-- IMU -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.01" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.011" />
      </geometry>
    </collision>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.05" rpy="0 0 0" />
    <parent link="base" />
    <child link="imu_link" />
  </joint>
  
  <!-- ======================== FRONT LEFT (FL) ======================== -->
